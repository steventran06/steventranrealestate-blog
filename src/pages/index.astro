---
import { getCollection } from "astro:content";
import Card from "@components/Card";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import Layout from "@layouts/Layout.astro";
import { SITE } from "@config";
import getSortedPosts from "@utils/getSortedPosts";

const allPosts = await getCollection("blog");
const sortedPosts = getSortedPosts(allPosts);

const featuredPosts = sortedPosts
  .filter(({ data }) => data.featured)
  .slice(0, 3);

const recentPosts = sortedPosts.slice(0, 6);

const topicLinks = [
  {
    title: "Relocation",
    href: "/tags/relocation/",
    description:
      "Moving to Portland or Southwest Washington? Start here."
  },
  {
    title: "Portland",
    href: "/tags/portland/",
    description:
      "Neighborhoods, housing and local market insights."
  },
  {
    title: "Home Buying",
    href: "/tags/home-buying/",
    description:
      "Practical guidance for making a smarter purchase."
  },
  {
    title: "New Construction",
    href: "/tags/new-construction/",
    description:
      "Builders, incentives, communities and new homes."
  },
  {
    title: "Investing",
    href: "/tags/real-estate-investing/",
    description:
      "Rental property, numbers and long-term strategy."
  },
  {
    title: "Southwest Washington",
    href: "/tags/washington/",
    description:
      "Vancouver, Camas and communities north of Portland."
  }
];
---

<Layout
  title={`${SITE.title} | Portland Real Estate Blog`}
  description="Portland Metro and Southwest Washington real estate insights, local guides, relocation advice, homebuyer resources, new construction and investing."
>
  <Header />

  <main id="main-content">

    <!-- HERO -->

    <section class="blog-home-hero">
      <img
        class="blog-home-hero-image"
        src="/assets/oregon-hero.png"
        alt="Portland Oregon"
        loading="eager"
        fetchpriority="high"
      />

      <div class="blog-home-hero-overlay"></div>

      <div class="blog-home-hero-inner">
        <div class="blog-home-hero-copy">
          <div class="eyebrow eyebrow-light">
            Portland Real Estate Blog
          </div>

          <h1>
            Portland Metro &amp; Southwest Washington
            <span>Real Estate Insights</span>
          </h1>

          <p>
            Local market updates, home buying advice, relocation resources,
            community guides, new construction and real estate investing.
          </p>

          <div class="blog-home-hero-actions">
            <a
              class="site-button site-button-primary"
              href="/posts/"
            >
              Browse Articles
            </a>

            <a
              class="site-button site-button-light"
              href="https://steventranrealestate.com/#relocation"
            >
              Portland Relocation Guide
            </a>
          </div>
        </div>
      </div>
    </section>


    <!-- FEATURED -->

    {
      featuredPosts.length > 0 && (
        <section class="page-section">
          <div class="site-container">

            <div class="section-heading centered-heading">
              <div class="eyebrow">
                Featured
              </div>

              <h2>
                Start Here
              </h2>

              <p>
                In-depth guides and resources for buying,
                relocating and investing around Portland Metro
                and Southwest Washington.
              </p>
            </div>

            <div class="featured-post-grid">
              {
                featuredPosts.map(post => (
                  <Card
                    href={`/posts/${post.slug}/`}
                    frontmatter={post.data}
                  />
                ))
              }
            </div>

          </div>
        </section>
      )
    }


    <!-- RECENT POSTS -->

    <section class="page-section section-soft">
      <div class="site-container">

        <div class="section-heading centered-heading">
          <div class="eyebrow">
            Latest From The Blog
          </div>

          <h2>
            Recent Articles
          </h2>

          <p>
            The latest Portland Metro and Southwest Washington real estate,
            relocation, home buying and market articles.
          </p>
        </div>

        <div class="post-grid">
          {
            recentPosts.map(post => (
              <Card
                href={`/posts/${post.slug}/`}
                frontmatter={post.data}
              />
            ))
          }
        </div>

        <div class="section-action">
          <a class="site-button site-button-secondary" href="/posts/">
            View All Articles
          </a>
        </div>

      </div>
    </section>


    <!-- TOPICS -->

    <section class="page-section">
      <div class="site-container">

        <div class="section-heading centered-heading">
          <div class="eyebrow">
            Explore By Topic
          </div>

          <h2>
            Find What You're Looking For
          </h2>

          <p>
            Browse real estate information based on where
            you are in your home buying, relocation or
            investing journey.
          </p>
        </div>

        <div class="topic-grid">
          {
            topicLinks.map(topic => (
              <a
                class="topic-card"
                href={topic.href}
              >
                <h3>
                  {topic.title}
                </h3>

                <p>
                  {topic.description}
                </p>

                <span>
                  Explore Topic →
                </span>
              </a>
            ))
          }
        </div>

      </div>
    </section>


    <!-- RELOCATION CTA -->

    <section class="relocation-cta-section">
      <div class="site-container">

        <div class="relocation-cta">

          <div class="relocation-cta-copy">

            <div class="eyebrow eyebrow-light">
              Moving To Portland?
            </div>

            <h2>
              Start With My Free Portland Relocation Guide
            </h2>

            <p>
              Get practical information about Portland-area
              neighborhoods, suburbs, housing and what to
              consider before making your move.
            </p>

          </div>

          <div class="relocation-cta-actions">

            <a
              class="site-button site-button-primary"
              href="https://steventranrealestate.com/#relocation"
            >
              Get the Free Guide
            </a>

            <a
              class="site-button site-button-light"
              href="https://calendly.com/steven-diverserg/new-meeting"
              target="_blank"
              rel="noopener noreferrer"
            >
              Schedule a Call
            </a>

          </div>

        </div>

      </div>
    </section>

  </main>

  <Footer />
</Layout>