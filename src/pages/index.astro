---
import { getCollection } from "astro:content";
import Card from "@components/Card";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import Layout from "@layouts/Layout.astro";
import { BRAND, IS_PORTLAND_HOME_GUIDE, SITE } from "@config";
import getSortedPosts from "@utils/getSortedPosts";

const allPosts = await getCollection("blog");
const sortedPosts = getSortedPosts(allPosts);

const featuredPosts = sortedPosts
  .filter(({ data }) => data.featured)
  .slice(0, 3);

const recentPosts = sortedPosts.slice(0, 6);

const topicLinks = [
  {
    title: "Relocation",
    href: "/tags/moving-to-portland/",
    description: "Moving to Portland or Southwest Washington? Start here."
  },
  {
    title: "Portland",
    href: "/tags/portland/",
    description: "Neighborhoods, housing and local market insights."
  },
  {
    title: "Home Buying",
    href: "/tags/portland-home-buyers/",
    description: "Practical guidance for making a smarter purchase."
  },
  {
    title: "Housing Market",
    href: "/tags/portland-housing-market/",
    description: "Local market updates, inventory and buyer conditions."
  },
  {
    title: "Affordability",
    href: "/tags/affordability/",
    description: "Prices, budgets and the cost of living around Portland."
  },
  {
    title: "Southwest Washington",
    href: "/tags/washington/",
    description: "Vancouver, Camas and communities north of Portland."
  }
];

const pageTitle = IS_PORTLAND_HOME_GUIDE
  ? "Portland Home Guide - Articles | Housing, Relocation & Local Research"
  : `${SITE.title} | Portland Real Estate Blog`;

const pageDescription = IS_PORTLAND_HOME_GUIDE
  ? "Long-form Portland Metro and Southwest Washington housing research, relocation guides, community comparisons, market explainers and practical home-buying context."
  : "Portland Metro and Southwest Washington real estate insights, local guides, relocation advice, homebuyer resources, new construction and investing.";
---

<Layout title={pageTitle} description={pageDescription}>
  <Header />

  <main id="main-content">
    <section class="blog-home-hero">
      <img
        class="blog-home-hero-image"
        src="/assets/oregon-hero.png"
        alt="Portland Oregon"
        loading="eager"
        fetchpriority="high"
      />

      <div class="blog-home-hero-overlay"></div>

      <div class="blog-home-hero-inner">
        <div class="blog-home-hero-copy">
          <div class="eyebrow eyebrow-light">
            {IS_PORTLAND_HOME_GUIDE ? "Portland Home Guide - Articles" : "Portland Real Estate Blog"}
          </div>

          <h1>
            Portland Metro &amp; Southwest Washington
            <span>
              {IS_PORTLAND_HOME_GUIDE ? "Housing & Relocation Research" : "Real Estate Insights"}
            </span>
          </h1>

          <p>
            {
              IS_PORTLAND_HOME_GUIDE
                ? "Long-form local guides, market explainers, community comparisons, relocation research and practical housing context to help guide you in the Portland Metro housing market"
                : "Local market updates, home buying advice, relocation resources, community guides, new construction and real estate investing."
            }
          </p>

          <div class="blog-home-hero-actions">
            <a class="site-button site-button-primary" href="/posts/">
              Browse Articles
            </a>

            {
              IS_PORTLAND_HOME_GUIDE ? (
                <a
                  class="site-button site-button-light"
                  href={BRAND.mainSiteUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Explore Portland Home Guide
                </a>
              ) : (
                <a class="site-button site-button-light" href={BRAND.relocationUrl}>
                  Portland Relocation Guide
                </a>
              )
            }
          </div>
        </div>
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section class="page-section">
          <div class="site-container">
            <div class="section-heading centered-heading">
              <div class="eyebrow">Featured</div>
              <h2>Start Here</h2>
              <p>
                {IS_PORTLAND_HOME_GUIDE
                  ? "In-depth research and practical guides for comparing communities, understanding housing decisions and planning a move around Portland Metro and Southwest Washington."
                  : "In-depth guides and resources for buying, relocating and investing around Portland Metro and Southwest Washington."}
              </p>
            </div>

            <div class="featured-post-grid">
              {featuredPosts.map(post => (
                <Card href={`/posts/${post.slug}/`} frontmatter={post.data} />
              ))}
            </div>
          </div>
        </section>
      )
    }

    <section class="page-section section-soft">
      <div class="site-container">
        <div class="section-heading centered-heading">
          <div class="eyebrow">Latest Articles</div>
          <h2>Recent Articles</h2>
          <p>
            {IS_PORTLAND_HOME_GUIDE
              ? "The latest local housing, relocation, community and market research for Portland Metro and Southwest Washington."
              : "The latest Portland Metro and Southwest Washington real estate, relocation, home buying and market articles."}
          </p>
        </div>

        <div class="post-grid">
          {recentPosts.map(post => (
            <Card href={`/posts/${post.slug}/`} frontmatter={post.data} />
          ))}
        </div>

        <div class="section-action">
          <a class="site-button site-button-secondary" href="/posts/">
            View All Articles
          </a>
        </div>
      </div>
    </section>

    <section class="page-section">
      <div class="site-container">
        <div class="section-heading centered-heading">
          <div class="eyebrow">Explore By Topic</div>
          <h2>Find What You're Looking For</h2>
          <p>
            {IS_PORTLAND_HOME_GUIDE
              ? "Browse deeper explainers by topic, from relocation and community research to home buying, new construction and investing."
              : "Browse real estate information based on where you are in your home buying, relocation or investing journey."}
          </p>
        </div>

        <div class="topic-grid">
          {topicLinks.map(topic => (
            <a class="topic-card" href={topic.href}>
              <h3>{topic.title}</h3>
              <p>{topic.description}</p>
              <span>Explore Topic →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="relocation-cta-section">
      <div class="site-container">
        <div class="relocation-cta">
          <div class="relocation-cta-copy">
            <div class="eyebrow eyebrow-light">
              {IS_PORTLAND_HOME_GUIDE ? "Keep Exploring" : "Moving To Portland?"}
            </div>

            <h2>
              {IS_PORTLAND_HOME_GUIDE
                ? "Use Portland Home Guide to Compare the Region"
                : "Start With My Free Portland Relocation Guide"}
            </h2>

            <p>
              {IS_PORTLAND_HOME_GUIDE
                ? "Move from long-form articles into city guides, neighborhood research, current housing market context and relocation resources on PortlandHomeGuide.com."
                : "Get practical information about Portland-area neighborhoods, suburbs, housing and what to consider before making your move."}
            </p>
          </div>

          <div class="relocation-cta-actions">
            {
              IS_PORTLAND_HOME_GUIDE ? (
                <>
                  <a
                    class="site-button site-button-primary"
                    href={BRAND.communitiesUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Compare Communities
                  </a>
                  <a
                    class="site-button site-button-light"
                    href={BRAND.relocationUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Relocation Guide
                  </a>
                </>
              ) : (
                <>
                  <a class="site-button site-button-primary" href={BRAND.relocationUrl}>
                    Get the Free Guide
                  </a>
                  <a
                    class="site-button site-button-light"
                    href={BRAND.helpUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Schedule a Call
                  </a>
                </>
              )
            }
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
