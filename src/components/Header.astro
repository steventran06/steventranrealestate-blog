---
export interface Props {
  activeNav?: "posts" | "tags" | "about" | "search";
}

const { activeNav } = Astro.props;
---

<header class="site-header">
  <a id="skip-to-content" href="#main-content">
    Skip to content
  </a>

  <div class="site-container site-header-inner">

    <a
      class="site-brand"
      href="/"
      aria-label="Steven Tran Real Estate Blog home"
    >
      <img
        class="site-brand-logo"
        src="/assets/steventranlogo.png"
        alt="Steven Tran Real Estate"
      />

      <span class="site-brand-subtitle">
        Real Estate Blog
      </span>
    </a>

    <button
      class="mobile-menu-button"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="site-navigation"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav
      id="site-navigation"
      class="site-navigation"
      aria-label="Main navigation"
    >
      <a href="https://steventranrealestate.com/">
        Real Estate
      </a>

      <a href="https://steventranrealestate.com/communities/">
        Communities
      </a>

      <a
        href="/posts/"
        class={activeNav === "posts" ? "active" : ""}
      >
        Articles
      </a>

      <a
        href="/tags/"
        class={activeNav === "tags" ? "active" : ""}
      >
        Topics
      </a>

      <a
        href="/about/"
        class={activeNav === "about" ? "active" : ""}
      >
        About
      </a>

      <a
        href="/search/"
        class={activeNav === "search" ? "active" : ""}
      >
        Search
      </a>

      <a
        class="nav-cta"
        href="https://calendly.com/steven-diverserg/new-meeting"
        target="_blank"
        rel="noopener noreferrer"
      >
        Schedule a Call
      </a>
    </nav>

  </div>
</header>

<script>
  function setupMenu() {
    const button =
      document.querySelector(
        ".mobile-menu-button"
      );

    const nav =
      document.querySelector(
        ".site-navigation"
      );

    if (
      !(button instanceof HTMLButtonElement) ||
      !(nav instanceof HTMLElement)
    ) {
      return;
    }

    button.addEventListener(
      "click",
      () => {
        const isOpen =
          nav.classList.toggle(
            "is-open"
          );

        button.setAttribute(
          "aria-expanded",
          String(isOpen)
        );

        button.setAttribute(
          "aria-label",
          isOpen
            ? "Close menu"
            : "Open menu"
        );
      }
    );
  }

  setupMenu();

  document.addEventListener(
    "astro:after-swap",
    setupMenu
  );
</script>