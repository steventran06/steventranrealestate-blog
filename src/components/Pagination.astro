---
export interface Props {
  currentPage: number;
  totalPages: number;
  prevUrl: string;
  nextUrl: string;
}

const {
  currentPage,
  totalPages,
  prevUrl,
  nextUrl
} = Astro.props;

const hasPrev = currentPage > 1;
const hasNext = currentPage < totalPages;
---

{
  totalPages > 1 && (
    <nav
      class="pagination-nav"
      aria-label="Article pages"
    >
      {
        hasPrev ? (
          <a
            href={prevUrl}
            class="pagination-link"
            aria-label="Previous page"
          >
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="M15 18 9 12l6-6"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>

            <span>Previous</span>
          </a>
        ) : (
          <span
            class="pagination-link pagination-disabled"
            aria-disabled="true"
          >
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="M15 18 9 12l6-6"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>

            <span>Previous</span>
          </span>
        )
      }

      <span class="pagination-current">
        Page {currentPage} of {totalPages}
      </span>

      {
        hasNext ? (
          <a
            href={nextUrl}
            class="pagination-link"
            aria-label="Next page"
          >
            <span>Next</span>

            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="m9 18 6-6-6-6"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        ) : (
          <span
            class="pagination-link pagination-disabled"
            aria-disabled="true"
          >
            <span>Next</span>

            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="m9 18 6-6-6-6"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
        )
      }
    </nav>
  )
}

<style>
  .pagination-nav {
    display: flex;

    width: fit-content;
    max-width: 100%;

    align-items: center;
    justify-content: center;

    gap: 26px;

    margin: 48px auto 20px;
    padding: 0;
  }

  .pagination-link {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    gap: 7px;

    min-width: 90px;

    color: var(--text-primary);

    font-family:
      "Poppins",
      sans-serif;

    font-size: 13px;
    font-weight: 700;

    line-height: 1;

    text-decoration: none;

    white-space: nowrap;

    transition:
      color 160ms ease,
      transform 160ms ease;
  }

  .pagination-link:hover {
    color: var(--brand-primary);
  }

  .pagination-link:first-child:hover {
    transform: translateX(-2px);
  }

  .pagination-link:last-child:hover {
    transform: translateX(2px);
  }

  .pagination-link svg {
    position: static !important;

    display: block !important;

    width: 17px !important;
    height: 17px !important;

    min-width: 17px !important;
    max-width: 17px !important;

    min-height: 17px !important;
    max-height: 17px !important;

    margin: 0 !important;
    padding: 0 !important;

    flex: 0 0 17px !important;

    fill: none !important;
    stroke: currentColor !important;

    transform: none !important;
  }

  .pagination-current {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    color: var(--text-secondary);

    font-size: 13px;
    font-weight: 600;

    line-height: 1;

    white-space: nowrap;
  }

  .pagination-disabled {
    color: #b9c0c8;

    opacity: 0.65;

    pointer-events: none;
  }

  @media (max-width: 575.98px) {
    .pagination-nav {
      gap: 14px;

      margin-top: 36px;
    }

    .pagination-link {
      min-width: auto;

      font-size: 12px;
    }

    .pagination-current {
      font-size: 12px;
    }

    .pagination-link svg {
      width: 15px !important;
      height: 15px !important;

      min-width: 15px !important;
      max-width: 15px !important;

      min-height: 15px !important;
      max-height: 15px !important;

      flex-basis: 15px !important;
    }
  }

  @media (max-width: 420px) {
    .pagination-nav {
      gap: 10px;
    }

    .pagination-link {
      font-size: 0;
    }

    .pagination-link svg {
      width: 18px !important;
      height: 18px !important;

      min-width: 18px !important;
      max-width: 18px !important;

      min-height: 18px !important;
      max-height: 18px !important;

      flex-basis: 18px !important;
    }
  }
</style>