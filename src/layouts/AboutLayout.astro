---
import { BRAND, IS_PORTLAND_HOME_GUIDE, SITE } from "@config";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import Layout from "./Layout.astro";

export interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;

const pageTitle = IS_PORTLAND_HOME_GUIDE ? "About Portland Home Guide" : frontmatter.title;

const description = IS_PORTLAND_HOME_GUIDE
  ? "Learn how the Portland Home Guide Articles complements PortlandHomeGuide.com with long-form community research, relocation guides, market explainers and practical housing context."
  : frontmatter.description ??
    "Learn more about Steven Tran, an Oregon and Washington real estate broker, investor and property manager serving Portland Metro and Southwest Washington.";
---

<Layout
  title={`${pageTitle} | ${SITE.title}`}
  description={description}
>
  <Header activeNav="about" />

  {
    IS_PORTLAND_HOME_GUIDE ? (
  <main id="main-content" class="phg-about-page">
    <section class="about-page-hero">
      <div class="site-container about-page-hero-inner">
        <div class="about-page-hero-copy">
          <div class="eyebrow">About Portland Home Guide Articles</div>

          <h1>
            Local Insight for Better
            <span>Portland-Area Housing Decisions.</span>
          </h1>

          <p>
            Portland Home Guide Articles explores the housing market, communities,
            relocation considerations and real estate decisions shaping Portland
            Metro and Southwest Washington.
          </p>

          <div class="about-page-actions">
            <a
              class="site-button site-button-primary"
              href={BRAND.mainSiteUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Explore Portland Home Guide
            </a>

            <a class="site-button site-button-secondary" href="/posts/">
              Browse Articles
            </a>
          </div>
        </div>

        <div class="about-page-photo-wrap phg-about-photo-wrap">
          <div class="about-page-photo-accent"></div>
          <img
            class="about-page-photo phg-about-photo"
            src="/assets/oregon-hero.png"
            alt="Portland Oregon landscape"
            loading="eager"
          />
        </div>
      </div>
    </section>

    <section class="page-section">
      <div class="site-container">
        <div class="about-page-content-grid">
          <aside class="about-page-sidebar">
            <div class="about-page-sidebar-card">
              <div class="eyebrow">Explore Portland Home Guide</div>
              <h2>Research the Portland Metro</h2>
              <p>
                Explore community guides, neighborhood information, housing market
                data and relocation resources across Portland Metro and Southwest
                Washington.
              </p>

              <div class="about-page-contact-list phg-resource-links">
                <a href={BRAND.mainSiteUrl} target="_blank" rel="noopener noreferrer">
                  PortlandHomeGuide.com
                </a>
                <a href={BRAND.communitiesUrl} target="_blank" rel="noopener noreferrer">
                  Compare Communities
                </a>
                <a href={BRAND.relocationUrl} target="_blank" rel="noopener noreferrer">
                  Portland Relocation Guide
                </a>
                <a href="/posts/">All Articles</a>
              </div>
            </div>
          </aside>

          <article class="about-page-prose prose">
            <h2>What You'll Find Here</h2>
            <p>
              Portland Home Guide Articles takes a closer look at the questions,
              trends and trade-offs that matter when deciding where to live, whether
              to move, or how to approach the local housing market.
            </p>

            <p>
              Topics range from comparisons like Portland versus Beaverton or Oregon
              versus Washington to housing affordability, taxes, commuting, transit,
              new construction, home buying, real estate investing and changing
              market conditions.
            </p>

            <p>
              The goal is to go beyond surface-level statistics and explain what the
              numbers, policies and regional differences may actually mean for people
              making real housing decisions.
            </p>

            <h2>Research With More Context</h2>
            <p>
              PortlandHomeGuide.com provides structured information about cities,
              neighborhoods and housing markets throughout the region. These articles
              provide another layer of context by exploring specific questions and
              topics in greater depth.
            </p>

            <p>
              You might use a community guide to compare home prices, housing types
              and market activity, then read an article to better understand why
              those differences exist or how they could affect your decision.
            </p>

            <p>
              Together, the goal is to make Portland-area housing information easier
              to research, compare and understand.
            </p>

            <h2>Independent, Local Housing Research</h2>
            <p>
              Portland Home Guide is built around a simple idea: people should have
              access to useful local information before making a major housing
              decision.
            </p>

            <p>
              That means looking at more than listings or median sale prices. It
              means considering neighborhoods, transportation, taxes, development,
              housing supply, affordability, lifestyle and the trade-offs that can
              vary significantly from one part of the Portland region to another.
            </p>

            <h2>Who Creates Portland Home Guide?</h2>
            <p>
              Portland Home Guide was created by Steven Tran, a Portland native,
              real estate investor and licensed real estate broker in Oregon and
              Washington.
            </p>

            <p>
              The research is informed by local market data, firsthand knowledge of
              the region and the questions that regularly come up in conversations
              with home buyers, homeowners, investors and people relocating to the
              Portland area.
            </p>

            <p>
              Portland Home Guide is intentionally designed to put the information
              first. Readers who want to learn more about Steven's professional
              background or work with him directly can find that information
              separately on his real estate website.
            </p>

            <p>
              <a href={BRAND.externalAboutUrl} target="_blank" rel="noopener noreferrer">
                Learn more about Steven Tran →
              </a>
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="page-section section-soft about-experience-section">
      <div class="site-container">
        <div class="section-heading centered-heading">
          <div class="eyebrow">Explore the Articles</div>
          <h2>Understand the Portland Housing Market From More Than One Angle</h2>
          <p>
            Explore the communities, market forces and practical considerations that
            shape housing decisions throughout the Portland region.
          </p>
        </div>

        <div class="about-experience-grid">
          <article class="about-experience-card">
            <span class="about-experience-number">01</span>
            <h3>Communities & Neighborhoods</h3>
            <p>
              Compare Portland-area cities and neighborhoods through housing,
              location, lifestyle, access and the trade-offs between them.
            </p>
          </article>

          <article class="about-experience-card">
            <span class="about-experience-number">02</span>
            <h3>Housing Market</h3>
            <p>
              Understand prices, inventory, affordability, interest rates and other
              forces affecting buyers, sellers and homeowners.
            </p>
          </article>

          <article class="about-experience-card">
            <span class="about-experience-number">03</span>
            <h3>Moving to Portland</h3>
            <p>
              Research commuting, transportation, weather, taxes and regional
              differences before relocating to Portland or Southwest Washington.
            </p>
          </article>

          <article class="about-experience-card">
            <span class="about-experience-number">04</span>
            <h3>Buying & Owning</h3>
            <p>
              Explore home buying, new construction, homeownership and real estate
              investing with the local context behind the decision.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="about-page-cta-section">
      <div class="site-container">
        <div class="about-page-cta">
          <div>
            <div class="eyebrow eyebrow-light">Explore Portland Home Guide</div>
            <h2>Turn Your Research Into a Better Housing Decision</h2>
            <p>
              Compare communities, explore neighborhood guides, review current
              housing data and access relocation resources for Portland Metro and
              Southwest Washington.
            </p>
          </div>

          <div class="about-page-cta-actions">
            <a
              class="site-button site-button-primary"
              href={BRAND.mainSiteUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Explore Portland Home Guide
            </a>

            <a
              class="site-button site-button-light"
              href={BRAND.communitiesUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Compare Communities
            </a>

            <a
              class="site-button site-button-light"
              href={BRAND.relocationUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Relocation Guide
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
    ) : (
  <main id="main-content">
    <section class="about-page-hero">
      <div class="site-container about-page-hero-inner">
        <div class="about-page-hero-copy">
          <div class="eyebrow">
            About Steven Tran
          </div>

          <h1>
            Local Real Estate Experience,
            <span>
              Built From the Investor Side First.
            </span>
          </h1>

          <p>
            Oregon and Washington real estate broker serving Portland Metro
            and Southwest Washington, with hands-on experience as an investor,
            property manager and real estate industry leader.
          </p>

          <div class="about-page-actions">
            <a
              class="site-button site-button-primary"
              href="https://calendly.com/steven-diverserg/new-meeting"
              target="_blank"
              rel="noopener noreferrer"
            >
              Schedule a Call
            </a>

            <a
              class="site-button site-button-secondary"
              href="https://steventranrealestate.com/communities/"
            >
              Explore Communities
            </a>
          </div>
        </div>

        <div class="about-page-photo-wrap">
          <div class="about-page-photo-accent"></div>

          <img
            class="about-page-photo"
            src="/assets/steventran.jpeg"
            alt="Steven Tran, Oregon and Washington real estate broker"
          />
        </div>
      </div>
    </section>

    <section class="page-section">
      <div class="site-container">
        <div class="about-page-content-grid">

          <aside class="about-page-sidebar">
            <div class="about-page-sidebar-card">
              <div class="eyebrow">
                Connect With Me
              </div>

              <h2>
                Real Estate Resources &amp; Content
              </h2>

              <p>
                Follow along for Portland Metro home tours, real estate tips,
                local insights and resources for buyers, sellers and investors.
              </p>

              <div class="about-page-contact-list">

                <!-- YouTube -->

                <a
                  href="https://youtube.com/@steventran_pdxrealtor"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="about-link-icon">
                    <svg
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        fill="currentColor"
                        d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4L15.8 12l-6.2 3.6Z"
                      />
                    </svg>
                  </span>

                  <span>
                    <strong>
                      YouTube
                    </strong>

                    <small>
                      Home Tours &amp; Real Estate Tips
                    </small>
                  </span>
                </a>

                <!-- Instagram -->

                <a
                  href="https://instagram.com/steventranpdx"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="about-link-icon">
                    <svg
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        fill="currentColor"
                        d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7Zm10.5 1.5a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z"
                      />
                    </svg>
                  </span>

                  <span>
                    <strong>
                      Instagram
                    </strong>

                    <small>
                      @steventranpdx
                    </small>
                  </span>
                </a>

                <!-- Main Website -->

                <a
                  href="https://steventranrealestate.com/"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="about-link-icon">
                    <svg
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        fill="currentColor"
                        d="M12 3 2 11h3v9h6v-6h2v6h6v-9h3L12 3Zm0 2.6 6 4.8V18h-3v-6H9v6H6v-7.6l6-4.8Z"
                      />
                    </svg>
                  </span>

                  <span>
                    <strong>
                      Steven Tran Real Estate
                    </strong>

                    <small>
                      Main Website
                    </small>
                  </span>
                </a>

                <!-- Relocation Guide -->

                <a
                  href="https://steventranrealestate.com/#relocation"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="about-link-icon">
                    <svg
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        fill="currentColor"
                        d="m15 4 6-2v16l-6 2-6-2-6 2V4l6-2 6 2Zm-5-0.1v12.2l4 1.3V5.2l-4-1.3Zm6 1.3v12.5l3-1V4.2l-3 1Zm-8-1.3-3 1v12.5l3-1V3.9Z"
                      />
                    </svg>
                  </span>

                  <span>
                    <strong>
                      Portland Relocation Guide
                    </strong>

                    <small>
                      Free Local Guide
                    </small>
                  </span>
                </a>

                <!-- Podcast -->

                <a
                  href="https://www.youtube.com/@realizedgainspodcast"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="about-link-icon">
                    <svg
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        fill="currentColor"
                        d="M12 2a4 4 0 0 1 4 4v6a4 4 0 1 1-8 0V6a4 4 0 0 1 4-4Zm-2 4v6a2 2 0 1 0 4 0V6a2 2 0 1 0-4 0Zm-4 5h2v1a4 4 0 0 0 8 0v-1h2v1a6 6 0 0 1-5 5.9V20h3v2H8v-2h3v-2.1A6 6 0 0 1 6 12v-1Z"
                      />
                    </svg>
                  </span>

                  <span>
                    <strong>
                      REalized Gains Podcast
                    </strong>

                    <small>
                      Investing &amp; Entrepreneurship
                    </small>
                  </span>
                </a>

                <!-- Diverse Realty Group -->

                <a
                  href="https://steven.diverserg.com/"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <span class="about-link-icon">
                    <svg
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        fill="currentColor"
                        d="M4 3h10v6h6v12H4V3Zm2 2v14h3v-3h2v3h3V5H6Zm10 6v8h2v-8h-2ZM8 7h2v2H8V7Zm4 0h2v2h-2V7Zm-4 4h2v2H8v-2Zm4 0h2v2h-2v-2Z"
                      />
                    </svg>
                  </span>

                  <span>
                    <strong>
                      Diverse Realty Group
                    </strong>

                    <small>
                      Brokerage
                    </small>
                  </span>
                </a>

              </div>
            </div>
          </aside>

          <article class="about-page-prose prose">
            <slot />
          </article>

        </div>
      </div>
    </section>

    <section class="page-section section-soft about-experience-section">
      <div class="site-container">

        <div class="section-heading centered-heading">
          <div class="eyebrow">
            Experience
          </div>

          <h2>
            Real Estate From Multiple Perspectives
          </h2>

          <p>
            My work with clients is informed by practical experience in
            investing, property management, technology and industry leadership.
          </p>
        </div>

        <div class="about-experience-grid">

          <article class="about-experience-card">
            <span class="about-experience-number">
              01
            </span>

            <h3>
              Real Estate Broker
            </h3>

            <p>
              Licensed in Oregon and Washington and serving clients throughout
              Portland Metro and Southwest Washington.
            </p>
          </article>

          <article class="about-experience-card">
            <span class="about-experience-number">
              02
            </span>

            <h3>
              Investor + Property Manager
            </h3>

            <p>
              Hands-on experience with multifamily properties, rentals,
              renovations and evaluating long-term real estate opportunities.
            </p>
          </article>

          <article class="about-experience-card">
            <span class="about-experience-number">
              03
            </span>

            <h3>
              Industry + Community Leadership
            </h3>

            <p>
              Active in local and state real estate leadership, including
              AREAA Portland and Oregon REALTORS®.
            </p>
          </article>

          <article class="about-experience-card">
            <span class="about-experience-number">
              04
            </span>

            <h3>
              Business + Technology Background
            </h3>

            <p>
              A background in business marketing, internet marketing and
              software engineering shapes a practical, data-driven approach.
            </p>
          </article>

        </div>
      </div>
    </section>

    <section class="about-page-cta-section">
      <div class="site-container">

        <div class="about-page-cta">

          <div>
            <div class="eyebrow eyebrow-light">
              Thinking About Portland?
            </div>

            <h2>
              Start With My Free Portland Relocation Guide
            </h2>

            <p>
              Compare neighborhoods, suburbs and practical local information
              before you make your move.
            </p>
          </div>

          <div class="about-page-cta-actions">

            <a
              class="site-button site-button-primary"
              href="https://steventranrealestate.com/#relocation"
            >
              Get the Relocation Guide
            </a>

            <a
              class="site-button site-button-light"
              href="https://youtube.com/@steventran_pdxrealtor"
              target="_blank"
              rel="noopener noreferrer"
            >
              Watch on YouTube
            </a>

            <a
              class="site-button site-button-light"
              href="https://steventranrealestate.com/communities/"
            >
              Explore Communities
            </a>

            <a
              class="site-button site-button-light"
              href="https://calendly.com/steven-diverserg/new-meeting"
              target="_blank"
              rel="noopener noreferrer"
