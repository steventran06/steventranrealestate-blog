---
import type { CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Main from "@layouts/Main.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Pagination from "@components/Pagination.astro";
import Card from "@components/Card";
import { IS_PORTLAND_HOME_GUIDE, SITE } from "@config";

export interface Props {
  currentPage: number;
  totalPages: number;
  paginatedPosts: CollectionEntry<"blog">[];
}

const { currentPage, totalPages, paginatedPosts } = Astro.props;
---

<Layout title={`${IS_PORTLAND_HOME_GUIDE ? "Housing & Relocation Articles" : "Real Estate Articles"} | ${SITE.title}`}>
  <Header activeNav="posts" />
  <Main
    pageTitle={IS_PORTLAND_HOME_GUIDE ? "Housing & Relocation Articles" : "Real Estate Articles"}
    pageDesc={IS_PORTLAND_HOME_GUIDE ? "Long-form Portland Metro and Southwest Washington housing, relocation, community, market and home-buying research." : "Portland Metro and Southwest Washington relocation, home buying, market, community and investing insights."}
  >
    <ul class="post-card-grid">
      {paginatedPosts.map(({ data, slug }) => (
        <Card href={`/posts/${slug}/`} frontmatter={data} />
      ))}
    </ul>
  </Main>

  <Pagination
    {currentPage}
    {totalPages}
    prevUrl={`/posts${currentPage - 1 !== 1 ? "/" + (currentPage - 1) : ""}/`}
    nextUrl={`/posts/${currentPage + 1}/`}
  />

  <Footer noMarginTop={totalPages > 1} />
</Layout>
