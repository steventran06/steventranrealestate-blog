---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Tag from "@components/Tag.astro";
import Datetime from "@components/Datetime";
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@utils/slugify";
import ShareLinks from "@components/ShareLinks.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { BRAND, IS_PORTLAND_HOME_GUIDE, SITE } from "@config";

export interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const {
  title,
  author,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  tags,
} = post.data;

const { Content } = await post.render();
const ogImageUrl = typeof ogImage === "string" ? ogImage : ogImage?.src;
const ogUrl = new URL(
  ogImageUrl ?? `/posts/${slugifyStr(title)}.png`,
  Astro.site ?? Astro.url.origin
).href;

const articleCanonicalURL = canonicalURL ?? new URL(Astro.url.pathname, Astro.site).href;
const authorUrl = "https://steventranrealestate.com/about/";
const publisherUrl = BRAND.mainSiteUrl.replace(/\/$/, "");
const publisherName = IS_PORTLAND_HOME_GUIDE
  ? "Portland Home Guide"
  : "Steven Tran Real Estate";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": `${articleCanonicalURL}#article`,
      headline: title,
      description,
      image: [ogUrl],
      datePublished: pubDatetime.toISOString(),
      ...(modDatetime ? { dateModified: modDatetime.toISOString() } : {}),
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": articleCanonicalURL,
      },
      author: {
        "@type": "Person",
        "@id": `${authorUrl}#steven-tran`,
        name: "Steven Tran",
        url: authorUrl,
        sameAs: [
          "https://www.instagram.com/steventranpdx",
          "https://www.linkedin.com/in/steventran06/",
          "https://www.youtube.com/@steventran_pdxrealtor",
          "https://www.facebook.com/StevenTranPDXRealtor/",
        ],
      },
      publisher: {
        "@type": "Organization",
        "@id": `${publisherUrl}/#organization`,
        name: publisherName,
        url: `${publisherUrl}/`,
      },
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${articleCanonicalURL}#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: new URL("/", Astro.site).href,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Articles",
          item: new URL("/posts/", Astro.site).href,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: title,
          item: articleCanonicalURL,
        },
      ],
    },
  ],
};

const layoutProps = {
  title: `${title} | ${SITE.title}`,
  author,
  description,
  pubDatetime,
  modDatetime,
  canonicalURL: articleCanonicalURL,
  ogImage: ogUrl,
  structuredData,
  scrollSmooth: true,
};
---

<Layout {...layoutProps}>
  <Header activeNav="posts" />

  <main id="main-content" class="article-page">
    <div class="site-container article-header-shell">
      <Breadcrumbs />
      <a class="back-link" href="/posts/">← All Articles</a>

      <header class="article-header">
        <div class="eyebrow">{BRAND.articleEyebrow}</div>
        <h1 transition:name={slugifyStr(title)}>{title}</h1>
        <p class="article-description">{description}</p>
        <div class="article-date">
          <Datetime pubDatetime={pubDatetime} modDatetime={modDatetime} size="lg" />
        </div>
      </header>
    </div>

    <article id="article" role="article" class="prose article-content">
      <Content />

      <section class="author-card">
        <img src="/assets/steventran.jpeg" alt="Steven Tran" loading="lazy" />
        <div>
          <div class="eyebrow">About the Author</div>
          <h2>Steven Tran</h2>
          {
            IS_PORTLAND_HOME_GUIDE ? (
              <p>
                Steven Tran is a Portland-area real estate broker, investor and the creator of
                Portland Home Guide. He contributes local housing, relocation and market context
                to help readers make more informed decisions across Portland Metro and Southwest Washington.
              </p>
            ) : (
              <p>
                Oregon and Washington real estate broker serving Portland Metro and Southwest Washington.
                I work with relocation buyers, first-time and move-up buyers, investors and new construction clients.
              </p>
            )
          }
          <div class="author-actions">
            {
              IS_PORTLAND_HOME_GUIDE ? (
                <>
                  <a class="site-button site-button-primary" href="/about/">
                    About Portland Home Guide
                  </a>
                  <a
                    class="site-button site-button-secondary"
                    href={BRAND.externalAboutUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    About Steven Tran
                  </a>
                </>
              ) : (
                <>
                  <a
                    class="site-button site-button-primary"
                    href={BRAND.helpUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Schedule a Call
                  </a>
                  <a class="site-button site-button-secondary" href={BRAND.externalAboutUrl}>
                    Visit My Real Estate Site
                  </a>
                </>
              )
            }
          </div>
        </div>
      </section>

      {
        IS_PORTLAND_HOME_GUIDE ? (
          <section class="article-relocation-cta">
            <div class="eyebrow eyebrow-light">Continue Your Research</div>
            <h2>Explore More on Portland Home Guide</h2>
            <p>
              Compare communities, neighborhood information, housing market context and relocation resources across the Portland region and Southwest Washington.
            </p>
            <div class="author-actions">
              <a
                class="site-button site-button-primary"
                href={BRAND.mainSiteUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                Explore Portland Home Guide
              </a>
              <a
                class="site-button site-button-light"
                href={BRAND.communitiesUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                Compare Communities
              </a>
            </div>
          </section>
        ) : (
          <section class="article-relocation-cta">
            <div class="eyebrow eyebrow-light">Moving to Portland?</div>
            <h2>Get My Free Portland Relocation Guide</h2>
            <p>
              Start comparing Portland neighborhoods, suburbs, housing and local lifestyle before you arrive.
            </p>
            <a class="site-button site-button-light" href={BRAND.relocationUrl}>
              Get the Relocation Guide
            </a>
          </section>
        )
      }
    </article>

    <div class="site-container article-footer-tools">
      <ul class="article-tags">
        {tags.map(tag => <Tag tag={slugifyStr(tag)} />)}
      </ul>

      <div class="article-share-row">
        <ShareLinks />
        <button id="back-to-top" class="back-to-top">Back to Top ↑</button>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script is:inline>
  function addHeadingLinks() {
    const headings = Array.from(document.querySelectorAll("#article h2, #article h3, #article h4"));
    for (const heading of headings) {
      if (!heading.id) continue;
      const link = document.createElement("a");
      link.innerText = "#";
      link.className = "heading-link";
      link.href = "#" + heading.id;
      link.ariaHidden = "true";
      heading.appendChild(link);
    }
  }

  addHeadingLinks();

  document.querySelector("#back-to-top")?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
  });
</script>
